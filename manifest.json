{
  "manifest_version": 3,
  "name": "Tab Vault",
  "version": "0.1.0",
  "description": "Save, close, and restore Chrome tab workspaces locally.",
  "key": "",
  "permissions": ["tabs", "storage", "alarms"],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tab Vault",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png"
    }
  }
}
